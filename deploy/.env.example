# InferGate — environment tunables.
#
# Usage:
#   cp deploy/.env.example deploy/.env
#   edit deploy/.env
#   docker compose -f deploy/docker-compose.yml --profile <model> up -d
#
# Every variable is read at model load time via OmegaConf's ${oc.env:...}
# resolver in config/models/*.yaml. Unset vars fall back to laptop-safe
# defaults (quantised, CPU offload, conservative concurrency).

# ═══════════════════════════════════════════════════════════════════════
# Gateway / global
# ═══════════════════════════════════════════════════════════════════════

# Gated-model access (FLUX.1-dev, Llama-3.1 requires license accept on HF).
HF_TOKEN=

# Compose build bases. Override when deploying to a host with different CUDA.
# RTX 30xx/40xx: pytorch/pytorch:2.6.0-cuda12.6-cudnn9-runtime
GPU_BASE_IMAGE=pytorch/pytorch:2.7.1-cuda12.8-cudnn9-runtime
VLLM_IMAGE=vllm/vllm-openai:v0.19.0
PORT=8000

# Host dir for the HuggingFace model cache (bind-mounted to /app/models
# inside every worker). Default: ../models (relative to deploy/). Override
# to relocate the cache off the project/system drive, e.g. to a data disk.
# On Windows use forward slashes (e.g. D:/InferGate/models) — Docker Compose
# parses them reliably as a bind-mount source.
# MODELS_DIR=/mnt/data/infergate/models

# ═══════════════════════════════════════════════════════════════════════
# Memory safety — container-level limits to stop a runaway model
# from taking down the host. Tune up on beefier servers.
# ═══════════════════════════════════════════════════════════════════════

# Per-GPU-worker RAM cap. If a model overshoots (e.g. SDXL base + refiner
# at 1024×1024 on 12 GB VRAM card), Linux OOMKiller kills the container
# process — HOST survives. Default 16g covers single large diffusion
# models; bump to 24-32g on a server with room to spare.
# GPU_WORKER_MEM_LIMIT=16g

# Per-CPU-worker (kokoro, whisper) RAM cap.
# CPU_WORKER_MEM_LIMIT=6g

# Gateway container — small FastAPI process + request buffers only.
# GATEWAY_MEM_LIMIT=2g

# Shared memory for GPU workers (torch multiprocessing uses /dev/shm).
# GPU_WORKER_SHM_SIZE=2g

# Torch allocator tuning. Default enables aggressive fragmentation GC +
# caps block size to reduce ensemble OOM. Override to
# "expandable_segments:True" ONLY on non-Blackwell cards without cpu_offload.
# PYTORCH_CUDA_ALLOC_CONF=garbage_collection_threshold:0.8,max_split_size_mb:512

# Default profiles for `docker compose up` (comma-separated; no --profile flag
# needed if set). Categories: text | image | tts. Individual: qwen3.5-4b,
# qwen-image, flux1-dev, flux1-schnell, flux2-klein-4b, sd35-medium,
# kokoro-82m, openaudio-s1-mini, llama3.1-8b, qwen3.5-9b, qwen3-8b.
# COMPOSE_PROFILES=text,tts
# COMPOSE_PROFILES=qwen-image

# ═══════════════════════════════════════════════════════════════════════
# Per-model tunables.
# Naming: <MODEL_ID>_<FIELD>  (MODEL_ID uppercased, - and . → _).
# Unset a var → laptop-safe default from the YAML. Set it to override.
#
# Bool: true|false   Int: 30   Float: 0.90   Null: null
# ═══════════════════════════════════════════════════════════════════════

# ─── Text (vLLM) ───────────────────────────────────────────────────────
# QWEN3_5_4B_ENABLED=true
# QWEN3_5_4B_QUANTIZATION=compressed-tensors
# QWEN3_5_4B_GPU_MEM_UTIL=0.90
# QWEN3_5_4B_CONTEXT_LENGTH=16384
# QWEN3_5_4B_MAX_CONCURRENT=1
# QWEN3_5_4B_MAX_TOKENS=4096
# QWEN3_5_4B_TEMPERATURE=0.7

# QWEN3_5_9B_ENABLED=true
# QWEN3_5_9B_GPU_MEM_UTIL=0.90
# QWEN3_5_9B_CONTEXT_LENGTH=32768

# QWEN3_8B_ENABLED=true
# QWEN3_8B_GPU_MEM_UTIL=0.90

# LLAMA3_1_8B_ENABLED=true
# LLAMA3_1_8B_GPU_MEM_UTIL=0.90

# ─── Image (diffusers) ─────────────────────────────────────────────────
# qwen-image — 20B DiT. Laptop: nf4 + offload. Server (≥24GB): disable both.
# QWEN_IMAGE_ENABLED=true
# QWEN_IMAGE_QUANTIZATION=nf4           # nf4 | fp8 | null
# QWEN_IMAGE_CPU_OFFLOAD=true
# QWEN_IMAGE_STEPS=30
# QWEN_IMAGE_CFG=4.0
# QWEN_IMAGE_MAX_CONCURRENT=1

# flux1-dev — gated. 12B transformer + 5B T5. Laptop: offload. Server: off.
# FLUX1_DEV_CPU_OFFLOAD=true
# FLUX1_DEV_QUANTIZATION=null           # or nf4 on <12GB cards
# FLUX1_DEV_STEPS=28
# FLUX1_DEV_CFG=3.5

# FLUX1_SCHNELL_CPU_OFFLOAD=true
# FLUX1_SCHNELL_STEPS=4

# FLUX2_KLEIN_4B_CPU_OFFLOAD=true
# FLUX2_KLEIN_4B_STEPS=4

# sd35-medium — drop_t5=true saves ~9.5GB on 12GB cards. Server: false.
# SD35_MEDIUM_CPU_OFFLOAD=true
# SD35_MEDIUM_DROP_T5=true
# SD35_MEDIUM_STEPS=28
# SD35_MEDIUM_CFG=7.0

# ─── TTS ───────────────────────────────────────────────────────────────
# KOKORO_82M_DEVICE=cpu                 # or cuda on a GPU host
# KOKORO_82M_VOICE=af_heart
# KOKORO_82M_SPEED=1.0
# KOKORO_82M_OUTPUT_FORMAT=mp3
# KOKORO_82M_MAX_CONCURRENT=2

# OPENAUDIO_S1_MINI_ENABLED=true
# OPENAUDIO_S1_MINI_VOICE=default
# OPENAUDIO_S1_MINI_OUTPUT_FORMAT=wav
